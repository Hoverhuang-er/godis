{
  "openapi": "3.0.3",
  "info": {
    "title": "Godis API",
    "description": "Godis HTTP API provides token-based authentication and Redis command execution over HTTP. The Web Dashboard API provides query, monitoring, and statistics endpoints.\n\n## Services\n\n- **HTTP API Server** (port 63790): Token-based auth + Redis command execution\n- **Web Dashboard API** (port 63800): Query, hot keys, big keys, runtime stats",
    "version": "1.3.3"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:63790",
      "description": "Local godis HTTP API server (default port)"
    },
    {
      "url": "http://127.0.0.1:63800",
      "description": "Local godis Web Dashboard API server (default port)"
    }
  ],
  "paths": {
    "/api/auth": {
      "post": {
        "summary": "Authenticate and get an API token",
        "description": "Exchange the godis requirepass for a bearer token. The password is validated against the godis server's configured requirepass.",
        "operationId": "authenticate",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["password"],
                "properties": {
                  "password": {
                    "type": "string",
                    "description": "Godis requirepass (same as redis-cli AUTH)."
                  },
                  "expired": {
                    "type": "integer",
                    "description": "Token lifetime in hours. 0 = permanent. Default 72.",
                    "minimum": 0,
                    "default": 72
                  }
                }
              },
              "example": {
                "password": "your-redis-password",
                "expired": 72
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token issued successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "128-char bearer token"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    },
                    "permanent": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "token": "ABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGH",
                  "expires_at": "2026-07-27T05:58:19Z",
                  "permanent": false
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                },
                "example": { "error": "invalid JSON body" }
              }
            }
          },
          "401": {
            "description": "Wrong password",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                },
                "example": { "error": "invalid password" }
              }
            }
          }
        }
      }
    },
    "/api/commands": {
      "get": {
        "summary": "Execute a Redis command",
        "description": "Execute any Redis command via HTTP query parameters. Parameters are translated to Redis RESP command and executed against the local godis instance.\n\n**Command mapping:** type=command, key=key, value=value, field=hash-field, member=set/sorted-set-member, score=sorted-set-score, args=extra-space-separated-args, db=database-index",
        "operationId": "executeCommand",
        "tags": ["Commands"],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Redis command (lowercase). E.g. set, get, hget, lpush, zadd, json.set, bf.add",
            "example": "set"
          },
          {
            "name": "key",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Redis key",
            "example": "mykey"
          },
          {
            "name": "value",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Value / secondary argument",
            "example": "bar"
          },
          {
            "name": "field",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Hash field name",
            "example": "name"
          },
          {
            "name": "member",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Set / SortedSet member",
            "example": "member1"
          },
          {
            "name": "score",
            "in": "query",
            "schema": { "type": "string" },
            "description": "SortedSet score",
            "example": "1.0"
          },
          {
            "name": "args",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Extra space-separated args (NX, EX, CH, etc.)",
            "example": "NX EX 3600"
          },
          {
            "name": "db",
            "in": "query",
            "schema": { "type": "integer", "minimum": 0, "maximum": 15 },
            "description": "Database index (0-15)",
            "example": 0
          }
        ],
        "security": [{ "AuthTokenHeader": [] }],
        "responses": {
          "200": {
            "description": "Command result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "result": { "type": "string", "nullable": true },
                    "raw": { "type": "string", "nullable": true },
                    "error": { "type": "string", "nullable": true }
                  }
                },
                "examples": {
                  "stringSet": {
                    "summary": "SET key value",
                    "value": { "success": true, "result": "OK", "raw": "+OK\r\n" }
                  },
                  "stringGet": {
                    "summary": "GET key",
                    "value": { "success": true, "result": "bar", "raw": "$3\r\nbar\r\n" }
                  },
                  "error": {
                    "summary": "Redis error",
                    "value": { "success": false, "error": "WRONGTYPE ...", "raw": "-WRONGTYPE ...\r\n" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing type parameter",
            "content": {
              "application/json": {
                "example": { "success": false, "error": "type parameter is required" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "examples": {
                  "missingToken": {
                    "value": { "error": "missing X-HEADER-AUTHTOKEN header" }
                  },
                  "invalidToken": {
                    "value": { "error": "unauthorized - invalid or expired token" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/query": {
      "post": {
        "summary": "Execute a read-only Redis command (Dashboard)",
        "description": "Execute a read-only Redis command against the connected godis instance. Write commands (SET, DEL, etc.) are rejected for safety. Designed for the web dashboard Query tab.",
        "operationId": "dashboardQuery",
        "tags": ["Dashboard"],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["cmd"],
                "properties": {
                  "cmd": {
                    "type": "string",
                    "description": "Full Redis command line (e.g. GET mykey, HGETALL user:1)"
                  }
                }
              },
              "example": {
                "cmd": "GET mykey"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "result": { "type": "string" },
                    "error": { "type": "string" }
                  }
                },
                "example": {
                  "success": true,
                  "result": "\"bar\"",
                  "error": ""
                }
              }
            }
          },
          "400": {
            "description": "Write command rejected or missing cmd",
            "content": {
              "application/json": {
                "examples": {
                  "writeRejected": {
                    "value": { "success": false, "result": "", "error": "read-only commands only (write not allowed)" }
                  },
                  "missingCmd": {
                    "value": { "success": false, "result": "", "error": "cmd parameter required" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor": {
      "get": {
        "summary": "Get hot keys and big keys monitoring data (Dashboard)",
        "description": "Returns current hot key access counts (top 20) and recently detected big key observations.",
        "operationId": "dashboardMonitor",
        "tags": ["Dashboard"],
        "responses": {
          "200": {
            "description": "Monitoring data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hot_keys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": { "type": "string" },
                          "count": { "type": "integer", "format": "int64" }
                        }
                      }
                    },
                    "big_keys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": { "type": "string" },
                          "db": { "type": "integer" },
                          "type": { "type": "string" },
                          "size": { "type": "integer", "format": "int64" },
                          "bytes": { "type": "integer", "format": "int64" }
                        }
                      }
                    },
                    "db_stats": { "type": "array", "nullable": true }
                  }
                },
                "example": {
                  "hot_keys": [
                    { "key": "user:1001", "count": 1523 },
                    { "key": "cache:session", "count": 891 }
                  ],
                  "big_keys": [
                    { "key": "logs:2026-07", "db": 0, "type": "string", "size": 1, "bytes": 5242880 }
                  ],
                  "db_stats": null
                }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "Get server runtime statistics (Dashboard)",
        "description": "Returns server runtime statistics including uptime, goroutine count, memory usage, connections, and command throughput.",
        "operationId": "dashboardStats",
        "tags": ["Dashboard"],
        "responses": {
          "200": {
            "description": "Runtime statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uptime": { "type": "integer", "format": "int64" },
                    "goroutines": { "type": "integer" },
                    "memory": { "type": "integer", "format": "int64" },
                    "connections": { "type": "integer", "format": "int64" },
                    "commands": { "type": "integer", "format": "int64" },
                    "ops_per_sec": { "type": "integer", "format": "int64" }
                  }
                },
                "example": {
                  "uptime": 86400,
                  "goroutines": 34,
                  "memory": 16777216,
                  "connections": 12,
                  "commands": 150234,
                  "ops_per_sec": 1523
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AuthTokenHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-HEADER-AUTHTOKEN",
        "description": "Token from POST /api/auth. Send the raw token value (no 'Bearer' prefix). If requirepass is empty, this header is optional."
      }
    }
  },
  "tags": [
    { "name": "Authentication", "description": "Token-based API authentication" },
    { "name": "Commands", "description": "Redis command execution via HTTP" },
    { "name": "Dashboard", "description": "Web dashboard API — query, monitor, and stats endpoints" }
  ],
  "x-apifox": {
    "version": "2.0",
    "environments": [
      {
        "name": "Local Godis",
        "serverUrl": "http://127.0.0.1:63790",
        "description": "本地 godis HTTP API 开发环境",
        "variables": {
          "base_url": {
            "value": "http://127.0.0.1:63790",
            "description": "Godis HTTP API 地址"
          },
          "token": {
            "value": "",
            "description": "认证 Token — 通过 POST /api/auth 获取"
          }
        },
        "headers": {
          "X-HEADER-AUTHTOKEN": "{{token}}"
        }
      },
      {
        "name": "Dashboard",
        "serverUrl": "http://127.0.0.1:63800",
        "description": "Web Dashboard API 环境",
        "variables": {
          "base_url": {
            "value": "http://127.0.0.1:63800",
            "description": "Godis Dashboard API 地址"
          }
        }
      }
    ],
    "assertions": {
      "default": [
        {
          "type": "status_code",
          "value": 200,
          "comparison": "equals"
        }
      ]
    },
    "preRequestScript": "// 如果 token 为空，先调用 /api/auth 获取 token\nif (!pm.environment.get('token')) {\n    pm.sendRequest({\n        url: pm.environment.get('base_url') + '/api/auth',\n        method: 'POST',\n        header: { 'Content-Type': 'application/json' },\n        body: {\n            mode: 'raw',\n            raw: JSON.stringify({\n                password: pm.environment.get('password') || 'your-redis-password',\n                expired: 72\n            })\n        }\n    }, function (err, response) {\n        if (!err) {\n            var json = response.json();\n            pm.environment.set('token', json.token);\n        }\n    });\n}",
    "examples": [
      {
        "name": "01 - 获取 Token",
        "endpoint": "POST /api/auth",
        "parameters": {
          "body": {
            "contentType": "application/json",
            "data": {
              "password": "your-redis-password",
              "expired": 72
            }
          }
        }
      },
      {
        "name": "02 - SET 字符串",
        "endpoint": "GET /api/commands",
        "parameters": {
          "query": {
            "type": "set",
            "key": "hello",
            "value": "world"
          }
        }
      },
      {
        "name": "03 - GET 字符串",
        "endpoint": "GET /api/commands",
        "parameters": {
          "query": {
            "type": "get",
            "key": "hello"
          }
        }
      },
      {
        "name": "04 - HSET / HGET 哈希",
        "endpoint": "GET /api/commands",
        "parameters": {
          "query": {
            "type": "hset",
            "key": "user:1",
            "field": "name",
            "value": "Alice"
          }
        }
      },
      {
        "name": "05 - LPUSH / LRANGE 列表",
        "endpoint": "GET /api/commands",
        "parameters": {
          "query": {
            "type": "lpush",
            "key": "tasks",
            "value": "task1"
          }
        }
      },
      {
        "name": "06 - ZADD / ZRANGE 有序集合",
        "endpoint": "GET /api/commands",
        "parameters": {
          "query": {
            "type": "zadd",
            "key": "leaderboard",
            "score": "100",
            "member": "player1"
          }
        }
      },
      {
        "name": "07 - SADD / SMEMBERS 集合",
        "endpoint": "GET /api/commands",
        "parameters": {
          "query": {
            "type": "sadd",
            "key": "tags",
            "member": "golang"
          }
        }
      },
      {
        "name": "08 - 带过期时间的 SET",
        "endpoint": "GET /api/commands",
        "parameters": {
          "query": {
            "type": "set",
            "key": "temp",
            "value": "expires-in-1h",
            "args": "EX 3600"
          }
        }
      },
      {
        "name": "09 - 选择数据库",
        "endpoint": "GET /api/commands",
        "parameters": {
          "query": {
            "type": "get",
            "key": "foo",
            "db": "1"
          }
        }
      },
      {
        "name": "10 - JSON 模块命令",
        "endpoint": "GET /api/commands",
        "parameters": {
          "query": {
            "type": "json.set",
            "key": "doc",
            "value": "$",
            "args": "'{\"name\":\"test\"}'"
          }
        }
      },
      {
        "name": "11 - Dashboard 查询",
        "endpoint": "POST /api/query",
        "server": "Dashboard",
        "parameters": {
          "body": {
            "contentType": "application/x-www-form-urlencoded",
            "data": {
              "cmd": "GET mykey"
            }
          }
        }
      },
      {
        "name": "12 - Dashboard 监控数据",
        "endpoint": "GET /api/monitor",
        "server": "Dashboard"
      },
      {
        "name": "13 - Dashboard 统计信息",
        "endpoint": "GET /api/stats",
        "server": "Dashboard"
      }
    ]
  }
}
